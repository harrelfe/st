> ##  ---------------------------------------------------------------------
> ##  The same transitions fitted separately.  Treatment acts on the death
> ##  transition and not on weight, so one PO summary blends two different
> ##  things; fitting them apart is the multistate view.
> ##  ---------------------------------------------------------------------
> fw <- orm(wt   ~ rcs(yprev, 4) + rcs(wt0, 4) + week + tx, data = dl)
> fd <- lrm(dead ~ rcs(yprev, 4) * tx + rcs(wt0, 4) + week, data = d)
> 
> cat(sprintf('\nWeight transition among the living\n'),
+     sprintf('  tx log odds ratio %+.4f (SE %.4f)   <- should be 0\n',
+             coef(fw)['tx'], sqrt(vcov(fw)['tx', 'tx'])),
+     sep = '')

Weight transition among the living
  tx log odds ratio -0.0102 (SE 0.0065)   <- should be 0
>     
> ws <- seq(50, 95, length = 200)
> k  <- contrast(fd,
+                list(tx = 1, yprev = ws, wt0 = ws, week = round(m / 2)),
+                list(tx = 0, yprev = ws, wt0 = ws, week = round(m / 2)),
+                expand=FALSE)
> k <- k[.q(yprev, Contrast, Lower, Upper)]
> 
> # Treatment odds ratio for death in the following week as a function of weight in the previous week, from the first-order Markov logistic transition model, with 0.95 confidence band. The solid line marks no effect; the dashed lines are the true weekly hazard ratios built into the simulation, 0.472 for frail patients and 3.168 for robust ones. The model recovers both without ever observing frailty, crossing 1.0 just below 70 kg — the midpoint of the two latent weight centres, where weight no longer discriminates between them. Treatment × previous weight interaction χ² = 235.5 on 3 d.f., P ≈ 10⁻⁵⁰, while the comparison of survival between arms gives P = 0.33.
> 
> plt(exp(Contrast) ~ yprev, data = k, ymin = exp(Lower), ymax = exp(Upper),
+     type = type_ribbon(), log = 'y',
+     xlab = 'Weight in the previous week (kg)',
+     ylab = 'Treatment odds ratio for death in the following week')
